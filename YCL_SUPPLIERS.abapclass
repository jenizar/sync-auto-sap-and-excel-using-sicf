  method IF_HTTP_EXTENSION~HANDLE_REQUEST.

  DATA : lv_json TYPE string.

    DATA : lt_suppliers TYPE TABLE OF ytb_suppliers.

    SELECT * FROM ytb_suppliers INTO TABLE lt_suppliers.

 /ui2/cl_json=>serialize(
     EXPORTING
       data     = lt_suppliers      " Data to serialize
     RECEIVING
       r_json   = lv_json ).

    server->response->set_cdata(
      data = cl_demo_output=>get( lv_json ) ).

  endmethod.